<div style="max-width:480px;margin:0 auto;padding:32px 24px;font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;color:#0c0a13;">
  <div style="font-weight:700;font-size:20px;letter-spacing:-0.02em;margin-bottom:24px;">KT.</div>

  <h1 style="font-size:20px;margin:0 0 12px;">Reset your password</h1>

  <p style="font-size:15px;line-height:1.5;color:#3f3f46;margin:0 0 24px;">
    We got a request to reset the password for <strong><%= @admin.email %></strong>.
    This link expires in 30 minutes and can only be used once.
  </p>

  <p style="margin:0 0 24px;">
    <a href="<%= @reset_url %>"
       style="display:inline-block;padding:12px 24px;border-radius:10px;color:#ffffff;text-decoration:none;font-weight:600;font-size:15px;background:linear-gradient(90deg,#6366f1,#a855f7);">
      Reset password
    </a>
  </p>

  <p style="font-size:13px;line-height:1.5;color:#71717a;margin:0 0 8px;">
    If the button above doesn't work, copy and paste this link into your browser:
  </p>
  <p style="font-size:13px;word-break:break-all;color:#71717a;margin:0 0 24px;">
    <%= @reset_url %>
  </p>

  <p style="font-size:13px;line-height:1.5;color:#71717a;margin:0;">
    Didn't request this? You can safely ignore this email — your password won't change.
  </p>
</div>
