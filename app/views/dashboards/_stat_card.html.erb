<%# Reuses the exact icon paths from the sidebar nav (see
    app/views/shared/_admin_sidebar.html.erb) so each card visually matches
    the section it links to. %>
<% icon_paths = {
  projects: '<path d="M3 7a1 1 0 0 1 1-1h5l2 2h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/>',
  skills: '<path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8z"/>',
  experiences: '<rect x="3" y="8" width="18" height="12" rx="1.5"/><path d="M8 8V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>',
  educations: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/>',
  messages: '<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M3.5 6.5l8.5 6 8.5-6"/>',
  memory: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>'
}.freeze %>

<%= link_to card[:path], class: 'card stat-card' do %>
  <svg class="stat-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <%= icon_paths.fetch(card[:icon]).html_safe %>
  </svg>
  <div>
    <p class="stat-card-value meta"><%= card[:value] %></p>
    <p class="stat-card-label"><%= card[:label] %></p>
    <p class="small"><%= card[:sub] %></p>
  </div>
<% end %>
