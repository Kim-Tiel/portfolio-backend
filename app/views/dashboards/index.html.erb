<section class="card hero">
  <h2>Welcome to the CMS</h2>
  <p class="muted login-info">Signed in as <strong><%= current_admin&.email || 'Unknown' %></strong></p>
</section>

<div class="stat-cards">
  <% @stat_cards.each do |card| %>
    <%= render 'stat_card', card: card %>
  <% end %>
</div>

<div class="grid dashboard-grid">
  <div class="dashboard-main">
    <section class="card">
      <div class="actions-row">
        <h3>Recent messages</h3>
        <%= link_to 'View all', admin_resource_path('contact_messages'), class: 'secondary' %>
      </div>

      <% if @recent_contact_messages.any? %>
        <table class="table">
          <thead>
            <tr>
              <th>From</th>
              <th>Subject</th>
              <th>Received</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_contact_messages.each do |message| %>
              <tr>
                <td>
                  <%= link_to (message.name.presence || message.email), admin_contact_message_path(message) %>
                </td>
                <td><%= message.subject.presence || message.body.truncate(60) %></td>
                <td class="meta"><%= message.created_at.strftime('%Y-%m-%d %H:%M') %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="empty-state">
          <p>No contact messages yet.</p>
        </div>
      <% end %>
    </section>

    <section class="card mt">
      <h3>Skills by category</h3>
      <% if @skills_by_category.any? %>
        <%= bar_chart @skills_by_category, colors: ['#a78bfa'], library: { plugins: { legend: { display: false } } } %>
      <% else %>
        <div class="empty-state">
          <p>No skills yet.</p>
        </div>
      <% end %>
    </section>
  </div>

  <div>
    <section class="card">
      <h3>Content health</h3>
      <ul class="health-checklist">
        <% @health_checks.each do |check| %>
          <li class="<%= check[:done] ? 'health-done' : 'health-pending' %>">
            <span class="health-dot" aria-hidden="true"></span>
            <%= check[:label] %>
          </li>
        <% end %>
      </ul>
    </section>

    <section class="card mt">
      <h3>Messages, last 14 days</h3>
      <%= column_chart @contact_messages_by_day, colors: ['#a855f7'], library: { plugins: { legend: { display: false } } } %>
    </section>
  </div>
</div>
