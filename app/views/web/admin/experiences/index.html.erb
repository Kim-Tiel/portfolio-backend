<div class="actions-row">
  <div>
    <h2>Experiences</h2>
    <p class="small">Manage professional experiences.</p>
  </div>
  <div>
    <%= link_to 'New experience', admin_new_experience_path, class: 'primary' %>
  </div>
</div>

<% if @experiences.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Company</th>
        <th>Role</th>
        <th>Dates</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @experiences.each do |exp| %>
        <tr>
          <td><%= exp.company %></td>
          <td><%= exp.role %></td>
          <td class="meta"><%= exp.start_date %> — <%= exp.end_date || 'Present' %></td>
          <td class="actions">
            <%= link_to 'View', admin_experience_path(exp), class: 'secondary' %>
            <%= link_to 'Edit', admin_edit_experience_path(exp), class: 'secondary' %>
<<<<<<< HEAD
            <%= button_to 'Delete', admin_experience_path(exp), method: :delete, data: { confirm: 'Remove this experience?' }, class: 'danger', form: { style: 'display:inline' } %>
=======
            <%= button_to 'Delete', admin_experience_path(exp), method: :delete, class: 'danger', form: { style: 'display:inline', data: { confirm_message: 'Are you sure do you want to delete?', confirm_action: 'Delete', confirm_variant: 'danger' } } %>
>>>>>>> origin/develop
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <p>No experiences yet.</p>
    <%= link_to 'Add your first experience', admin_new_experience_path, class: 'primary' %>
  </div>
<% end %>
