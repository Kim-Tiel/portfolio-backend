<div class="actions-row" style="justify-content: space-between; align-items: center;">
  <div>
    <h2>Experiences</h2>
    <p class="small">Manage professional experiences.</p>
  </div>
  <div>
    <%= link_to 'New experience', admin_new_experience_path, class: 'primary' %>
  </div>
</div>

<table style="width:100%;border-collapse:collapse;margin-top:16px">
  <thead>
    <tr style="text-align:left;border-bottom:1px solid #e6eefc">
      <th style="padding:10px">Company</th>
      <th style="padding:10px">Role</th>
      <th style="padding:10px">Dates</th>
      <th style="padding:10px">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @experiences.each do |exp| %>
      <tr style="border-bottom:1px solid #f1f5fb">
        <td style="padding:10px;vertical-align:top"><%= exp.company %></td>
        <td style="padding:10px;vertical-align:top"><%= exp.role %></td>
        <td style="padding:10px;vertical-align:top"><%= exp.start_date %> — <%= exp.end_date || 'Present' %></td>
        <td style="padding:10px;vertical-align:top">
          <%= link_to 'View', admin_experience_path(exp), class: 'secondary' %>
          <%= link_to 'Edit', admin_edit_experience_path(exp), class: 'secondary' %>
          <%= button_to 'Delete', admin_experience_path(exp), method: :delete, data: { confirm: 'Remove this experience?' }, class: 'danger', form: { style: 'display:inline' } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
