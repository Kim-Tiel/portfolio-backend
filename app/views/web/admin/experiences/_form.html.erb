<%= form_with model: [:admin, @experience], local: true do |f| %>
  <% if @experience.errors.any? %>
    <div class="card" style="background:#fff6f6;border:1px solid #ffdede;margin-bottom:16px">
      <p style="color:#7f1d1d;font-weight:700">Please fix the following errors:</p>
      <ul>
        <% @experience.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
    <div>
      <%= f.label :company %>
      <%= f.text_field :company, class: 'input', required: true %>
    </div>

    <div>
      <%= f.label :role %>
      <%= f.text_field :role, class: 'input', required: true %>
    </div>

    <div>
      <%= f.label :location %>
      <%= f.text_field :location, class: 'input' %>
    </div>

    <div>
      <%= f.label :is_remote %>
      <div style="margin-top:8px">
        <%= f.check_box :is_remote %>
        <%= f.label :is_remote, 'Remote role' %>
      </div>
    </div>

    <div>
      <%= f.label :start_date %>
      <%= f.date_field :start_date, class: 'input' %>
    </div>

    <div>
      <%= f.label :end_date %>
      <%= f.date_field :end_date, class: 'input' %>
    </div>

    <div style="grid-column:1 / -1">
      <%= f.label :commit_hash %>
      <%= f.text_field :commit_hash, class: 'input' %>
      <p class="small">Optional commit hash reference for reproducible snapshots</p>
    </div>
  </div>

  <% if @experience.experience_highlights.any? %>
    <div class="card" style="margin-top:18px">
      <h3>Highlights</h3>
      <% f.fields_for :experience_highlights do |hf| %>
        <div style="display:grid;grid-template-columns:1fr 1fr auto;gap:12px;align-items:end;margin-top:12px">
          <div>
            <%= hf.label :text, 'Highlight' %>
            <%= hf.text_field :text, class: 'input' %>
          </div>
          <div>
            <%= hf.label :sort_order %>
            <%= hf.number_field :sort_order, class: 'input', min: 0 %>
          </div>
          <div>
            <%= hf.label :_destroy, 'Remove' %>
            <%= hf.check_box :_destroy %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div style="margin-top:18px;display:flex;gap:10px;flex-wrap:wrap;align-items:center">
    <%= f.submit(@experience.persisted? ? 'Save experience' : 'Create experience', class: 'primary') %>
    <%= link_to 'Cancel', @experience.persisted? ? admin_experience_path(@experience) : admin_experiences_path, class: 'secondary' %>
  </div>
<% end %>
