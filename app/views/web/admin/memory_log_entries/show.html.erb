<h2>Memory entry by <%= @entry.display_name %></h2>
<p class="small">Submitted at <%= @entry.created_at.strftime('%Y-%m-%d %H:%M') %></p>

<div class="card mt">
  <pre class="message-body"><%= @entry.message %></pre>
</div>

<p class="mt"><%= link_to 'Back', admin_memory_log_entries_path, class: 'secondary' %></p>
