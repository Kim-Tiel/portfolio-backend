<h2>Message from <%= @message.name.presence || @message.email %></h2>
<p class="small"><strong>Subject:</strong> <%= @message.subject.presence || '(no subject)' %></p>

<div class="card" style="margin-top:12px">
  <pre style="white-space:pre-wrap"><%= @message.body %></pre>
</div>

<p style="margin-top:12px"><%= link_to 'Back', admin_contact_messages_path, class: 'secondary' %></p>
