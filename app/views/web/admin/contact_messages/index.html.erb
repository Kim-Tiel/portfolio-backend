<h2>Contact messages</h2>
<p class="small">Messages submitted through the site contact form.</p>

<table style="width:100%;border-collapse:collapse;margin-top:12px">
  <thead>
    <tr style="text-align:left;border-bottom:1px solid #e6eefc">
      <th style="padding:8px">From</th>
      <th style="padding:8px">Subject</th>
      <th style="padding:8px">Received</th>
      <th style="padding:8px">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @messages.each do |m| %>
      <tr style="border-bottom:1px solid #f1f5fb">
        <td style="padding:8px;vertical-align:top"><%= m.name.presence || m.email %></td>
        <td style="padding:8px;vertical-align:top"><%= m.subject.presence || m.body.truncate(60) %></td>
        <td style="padding:8px;vertical-align:top"><%= m.created_at.strftime('%Y-%m-%d %H:%M') %></td>
        <td style="padding:8px;vertical-align:top">
          <%= link_to 'View', admin_contact_message_path(m), class: 'secondary' %>
          <%= button_to 'Delete', admin_contact_message_path(m), method: :delete, data: { confirm: 'Remove this message?' }, class: 'danger', form: { style: 'display:inline' } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
