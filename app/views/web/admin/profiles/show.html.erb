<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Profile — Admin</title>
  <%= render 'dashboards/dashboard_styles' %>
  <style>
    /* profile-specific tweaks */
    .profile-hero { display:flex; gap:20px; align-items:center }
    .avatar { width:160px; height:160px; border-radius:16px; overflow:hidden; flex:0 0 160px; background:#fff; display:flex;align-items:center;justify-content:center }
    .avatar img { width:100%; height:100%; object-fit:cover }
    .hero-info h1 { margin:0; font-size:28px }
    .hero-info p.lead { color:var(--muted); margin-top:6px }

    .stats { display:flex; gap:12px; margin-top:18px; flex-wrap:wrap }
    .stat { background:#fff; padding:12px 14px; border-radius:10px; box-shadow:var(--shadow); min-width:140px }
    .stat h3 { margin:0; font-size:18px }
    .stat p { margin:6px 0 0; color:var(--muted); font-size:13px }

    .stack-grid { display:flex; flex-wrap:wrap; gap:10px; margin-top:12px }
    .chip { background:#fff; border-radius:10px; padding:8px 10px; box-shadow:0 6px 18px rgba(16,24,40,0.04); font-weight:600 }

    .projects { margin-top:22px }
    .project-card { background:linear-gradient(180deg,#fff,#fbfbff); border-radius:12px; padding:14px; box-shadow:var(--shadow); }

    @media (max-width:880px){
      .profile-hero { flex-direction:column; align-items:flex-start }
      .avatar { width:120px;height:120px; }
      .main-content { padding-left: 16px }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <div class="left">
        <button id="burgerToggle" class="burger" aria-label="Toggle menu">☰</button>
        <div class="brand">Portfolio API — Admin</div>
      </div>

      <div class="right actions">
        <%= button_to 'Logout', logout_path, method: :delete, class: 'btn logout' %>
      </div>
    </div>
  </header>

  <div id="sideMenu" class="side-menu" aria-hidden="false">
    <h4 class="menu-title">Content</h4>
    <nav>
      <ul class="menu-list">
        <li><a href="/dashboard" class="menu-link">Dashboard</a></li>
        <li><a href="<%= admin_profile_path %>" class="menu-link">Profile</a></li>
        <li><a href="<%= admin_resource_path('projects') %>" class="menu-link">Projects</a></li>
        <li><a href="<%= admin_resource_path('skills') %>" class="menu-link">Skills</a></li>
      </ul>
    </nav>
  </div>

  <main class="container main-content">
    <div class="grid">
      <section class="card hero">
        <div class="profile-hero">
          <div class="avatar">
            <% if @profile.avatar_url.present? %>
              <img src="<%= @profile.avatar_url %>" alt="Avatar" />
            <% else %>
              <div style="font-size:34px;color:var(--accent-600);font-weight:700"><%= @profile.name.to_s.first&.upcase || 'A' %></div>
            <% end %>
          </div>

          <div class="hero-info">
            <h1><%= @profile.name.presence || 'Your Name' %></h1>
            <p class="lead"><%= @profile.title.presence || 'Your title' %> • <%= @profile.location.presence || 'Location' %></p>

            <p style="margin-top:8px" class="muted"><%= simple_format(@profile.hero_tagline.to_s) %></p>

            <div class="stats">
              <div class="stat">
                <h3><%= @profile.years_shipping || 0 %>+</h3>
                <p>Years shipping</p>
              </div>

              <div class="stat">
                <h3><%= @profile.completed_projects || 0 %></h3>
                <p>Completed projects</p>
              </div>

              <div class="stat">
                <h3><%= @profile.countries_worked_in || 0 %></h3>
                <p>Countries worked in</p>
              </div>

              <div class="stat">
                <h3><%= @profile.employer_satisfaction || 0 %>%</h3>
                <p>Employer satisfaction</p>
              </div>
            </div>

            <div style="margin-top:12px">
              <%= link_to 'Edit profile', edit_admin_profile_path, class: 'secondary' %>
            </div>

          </div>
        </div>

        <div class="projects">
          <h3 class="section-title">The stack, end to end.</h3>
          <div class="stack-grid">
            <% (@profile.available_for || []).each do |s| %>
              <div class="chip"><%= s %></div>
            <% end %>
            <%# Fallback sample chips %>
            <% if (@profile.available_for || []).empty? %>
              <div class="chip">Ruby on Rails</div>
              <div class="chip">PostgreSQL</div>
              <div class="chip">Vue.js</div>
              <div class="chip">Docker</div>
            <% end %>
          </div>

          <h3 class="section-title" style="margin-top:18px">Selected projects</h3>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px">
            <%# Link to admin projects list as placeholder for real project cards %>
            <div class="project-card">
              <strong>Projects</strong>
              <p class="small">Manage your portfolio projects from the projects admin.</p>
              <p style="margin-top:10px"><a class="primary" href="<%= admin_resource_path('projects') %>">Open Projects</a></p>
            </div>

            <div class="project-card">
              <strong>Contact messages</strong>
              <p class="small">View messages from site visitors.</p>
              <p style="margin-top:10px"><a class="primary" href="<%= admin_resource_path('contact_messages') %>">Open Messages</a></p>
            </div>
          </div>
        </div>

      </section>

      <aside class="card side-panel">
        <h4>Summary</h4>
        <p class="small">Quick metadata about the profile and links for admin tasks.</p>

        <ul style="margin-top:12px">
          <li class="small">Signed as: <strong><%= current_admin&.email %></strong></li>
          <li class="small">Profile record id: <%= @profile.id || '-' %></li>
        </ul>

        <p style="margin-top:12px"><%= link_to 'Back to dashboard', dashboard_path, class: 'secondary' %></p>
      </aside>
    </div>
  </main>

  <%= render 'dashboards/dashboard_scripts' %>
</body>
</html>
