<div class="actions-row">
  <div>
    <h2><%= @skill.name %></h2>
    <p class="small"><%= @skill.category.titleize %> skill</p>
  </div>
  <div>
    <%= link_to 'Edit', admin_edit_skill_path(@skill), class: 'secondary' %>
    <%= link_to 'Back to skills', admin_skills_path, class: 'secondary' %>
  </div>
</div>

<div class="card mt">
  <table class="table detail-table">
    <tbody>
      <% [
        ['Name', @skill.name],
        ['Category', @skill.category.titleize],
        ['Proficiency', @skill.proficiency],
        ['Featured', @skill.is_featured ? 'Yes' : 'No'],
        ['Icon slug', @skill.icon_slug],
        ['Sort order', @skill.sort_order]
      ].each do |label, value| %>
        <tr>
          <td><%= label %></td>
          <td><%= value.present? ? value : '—' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
