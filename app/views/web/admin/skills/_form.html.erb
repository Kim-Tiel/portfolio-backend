<%= form_with model: [:admin, @skill], local: true, html: { multipart: true }, data: (@skill.persisted? ? { confirm_message: 'Are you sure do you want to save data?', confirm_action: 'Save', confirm_skip_unchanged: 'true' } : {}) do |f| %>
  <% if @skill.errors.any? %>
    <div class="card form-errors">
      <p>Please fix the following errors:</p>
      <ul>
        <% @skill.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div>
      <%= f.label :name %>
      <%= f.text_field :name, class: 'input', required: true %>
    </div>

    <div>
      <%= f.label :category %>
      <%= f.select :category, Skill.categories.keys.map { |key| [key.titleize, key] }, {}, class: 'input' %>
    </div>

    <div>
      <%= f.label :proficiency %>
      <%= f.select :proficiency, Skill.proficiencies.keys.map { |key| [key.titleize, key] }, {}, class: 'input' %>
    </div>

    <div>
      <%= f.label :proficiency_percent, 'Proficiency %' %>
      <div class="range-field">
        <%= f.range_field :proficiency_percent, min: 0, max: 100, step: 1, class: 'range-slider',
                                                 data: { range_output: 'proficiency-percent-value' } %>
        <output id="proficiency-percent-value" class="range-value"><%= @skill.proficiency_percent %>%</output>
      </div>
      <p class="small">Drives the progress bar width on the public site (0–100).</p>
    </div>

    <div class="full">
      <%= f.label :icon, 'Icon (SVG)' %>
      <% if @skill.icon.attached? %>
        <p class="small"><img src="<%= @skill.icon_url %>" alt="Current icon" style="max-height: 64px; border-radius: 8px;" /></p>
      <% end %>
      <%= f.file_field :icon, class: 'input', accept: 'image/svg+xml' %>
      <p class="small">SVG only. Max 1MB. Leave blank when unattached to fall back to the initials badge.</p>
    </div>

    <div>
      <%= f.label :sort_order %>
      <%= f.number_field :sort_order, class: 'input', min: 0 %>
    </div>

    <div>
      <%= f.label :is_featured %>
      <div class="checkbox-field">
        <%= f.check_box :is_featured %>
        <%= f.label :is_featured, 'Featured skill' %>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit(@skill.persisted? ? 'Save skill' : 'Create skill', class: 'primary') %>
    <%= link_to 'Cancel', @skill.persisted? ? admin_skill_path(@skill) : admin_skills_path, class: 'secondary' %>
  </div>
<% end %>
