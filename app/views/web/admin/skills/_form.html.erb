<%= form_with model: [:admin, @skill], local: true do |f| %>
  <% if @skill.errors.any? %>
    <div class="card" style="background:#fff6f6;border:1px solid #ffdede;margin-bottom:16px">
      <p style="color:#7f1d1d;font-weight:700">Please fix the following errors:</p>
      <ul>
        <% @skill.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
    <div>
      <%= f.label :name %>
      <%= f.text_field :name, class: 'input', required: true %>
    </div>

    <div>
      <%= f.label :category %>
      <%= f.select :category, Skill.categories.keys.map { |key| [key.titleize, key] }, {}, class: 'input' %>
    </div>

    <div>
      <%= f.label :proficiency %>
      <%= f.text_field :proficiency, class: 'input' %>
    </div>

    <div>
      <%= f.label :icon_slug %>
      <%= f.text_field :icon_slug, class: 'input' %>
    </div>

    <div>
      <%= f.label :sort_order %>
      <%= f.number_field :sort_order, class: 'input', min: 0 %>
    </div>
  </div>

  <div style="margin-top:18px;display:flex;gap:10px;flex-wrap:wrap;align-items:center">
    <%= f.submit(@skill.persisted? ? 'Save skill' : 'Create skill', class: 'primary') %>
    <%= link_to 'Cancel', @skill.persisted? ? admin_skill_path(@skill) : admin_skills_path, class: 'secondary' %>
  </div>
<% end %>
