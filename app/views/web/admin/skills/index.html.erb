<div class="actions-row">
  <div>
    <h2>Skills</h2>
    <p class="small">Manage portfolio skills used by projects and experiences.</p>
  </div>
  <div>
    <%= link_to 'New skill', admin_new_skill_path, class: 'primary' %>
  </div>
</div>

<% if @skills.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Category</th>
        <th>Proficiency</th>
        <th>Featured</th>
        <th>Sort</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @skills.each do |skill| %>
        <tr>
          <td><%= skill.name %></td>
          <td><%= skill.category.titleize %></td>
          <td class="meta"><%= skill.proficiency %></td>
          <td><%= skill.is_featured ? 'Yes' : 'No' %></td>
          <td class="meta"><%= skill.sort_order %></td>
          <td class="actions">
            <%= link_to 'View', admin_skill_path(skill), class: 'secondary' %>
            <%= link_to 'Edit', admin_edit_skill_path(skill), class: 'secondary' %>
            <%= button_to 'Delete', admin_skill_path(skill), method: :delete, class: 'danger', form: { style: 'display:inline', data: { confirm_message: 'Are you sure do you want to delete?', confirm_action: 'Delete', confirm_variant: 'danger' } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <p>No skills yet.</p>
    <%= link_to 'Add your first skill', admin_new_skill_path, class: 'primary' %>
  </div>
<% end %>
