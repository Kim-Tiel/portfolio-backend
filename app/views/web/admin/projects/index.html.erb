<div class="actions-row" style="justify-content: space-between; align-items: center;">
  <div>
    <h2>Projects</h2>
    <p class="small">Manage portfolio projects in the admin CMS.</p>
  </div>
  <div>
    <%= link_to 'New project', admin_new_project_path, class: 'primary' %>
  </div>
</div>

<table style="width:100%;border-collapse:collapse;margin-top:16px">
  <thead>
    <tr style="text-align:left;border-bottom:1px solid #e6eefc">
      <th style="padding:10px">Title</th>
      <th style="padding:10px">Client</th>
      <th style="padding:10px">Status</th>
      <th style="padding:10px">Featured</th>
      <th style="padding:10px">Updated</th>
      <th style="padding:10px">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @projects.each do |project| %>
      <tr style="border-bottom:1px solid #f1f5fb">
        <td style="padding:10px;vertical-align:top"><%= project.title %></td>
        <td style="padding:10px;vertical-align:top"><%= project.client_type.presence || '—' %></td>
        <td style="padding:10px;vertical-align:top"><%= project.status.titleize %></td>
        <td style="padding:10px;vertical-align:top"><%= project.is_featured ? 'Yes' : 'No' %></td>
        <td style="padding:10px;vertical-align:top"><%= project.updated_at.strftime('%Y-%m-%d') %></td>
        <td style="padding:10px;vertical-align:top">
          <%= link_to 'View', admin_project_path(project), class: 'secondary' %>
          <%= link_to 'Edit', admin_edit_project_path(project), class: 'secondary' %>
          <%= button_to 'Delete', admin_project_path(project), method: :delete, data: { confirm: 'Remove this project?' }, class: 'danger', form: { style: 'display:inline' } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
