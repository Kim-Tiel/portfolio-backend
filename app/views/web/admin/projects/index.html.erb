<div class="actions-row">
  <div>
    <h2>Projects</h2>
    <p class="small">Manage portfolio projects in the admin CMS.</p>
  </div>
  <div>
    <%= link_to 'New project', admin_new_project_path, class: 'primary' %>
  </div>
</div>

<% if @projects.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Client</th>
        <th>Status</th>
        <th>Featured</th>
        <th>Updated</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @projects.each do |project| %>
        <tr>
          <td><%= project.title %></td>
          <td><%= project.client_type.presence || '—' %></td>
          <td><span class="badge"><%= project.status.titleize %></span></td>
          <td><%= project.is_featured ? 'Yes' : 'No' %></td>
          <td class="meta"><%= project.updated_at.strftime('%Y-%m-%d') %></td>
          <td class="actions">
            <%= link_to 'View', admin_project_path(project), class: 'secondary' %>
            <%= link_to 'Edit', admin_edit_project_path(project), class: 'secondary' %>
            <%= button_to 'Delete', admin_project_path(project), method: :delete, class: 'danger', form: { style: 'display:inline', data: { confirm_message: 'Are you sure do you want to delete?', confirm_action: 'Delete', confirm_variant: 'danger' } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= paginate @projects %>
<% else %>
  <div class="empty-state">
    <p>No projects yet.</p>
    <%= link_to 'Add your first project', admin_new_project_path, class: 'primary' %>
  </div>
<% end %>
