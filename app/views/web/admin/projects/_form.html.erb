<%= form_with model: [:admin, @project], local: true, data: (@project.persisted? ? { confirm_message: 'Are you sure do you want to save data?', confirm_action: 'Save', confirm_skip_unchanged: 'true' } : {}) do |f| %>
  <% if @project.errors.any? %>
    <div class="card form-errors">
      <p>Please fix the following errors:</p>
      <ul>
        <% @project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div>
      <%= f.label :title %>
      <%= f.text_field :title, class: 'input', required: true %>
    </div>

    <div>
      <%= f.label :slug %>
      <%= f.text_field :slug, class: 'input', required: true %>
    </div>

    <div>
      <%= f.label :client_type %>
      <%= f.text_field :client_type, class: 'input' %>
    </div>

    <div>
      <%= f.label :location %>
      <%= f.text_field :location, class: 'input' %>
    </div>

    <div>
      <%= f.label :status %>
      <%= f.select :status, Project.statuses.keys.map { |s| [s.titleize, s] }, {}, class: 'input' %>
    </div>

    <div>
      <%= f.label :is_featured %>
      <div class="checkbox-field">
        <%= f.check_box :is_featured %>
        <%= f.label :is_featured, 'Featured project' %>
      </div>
    </div>

    <div>
      <%= f.label :started_on %>
      <%= f.date_field :started_on, class: 'input' %>
    </div>

    <div>
      <%= f.label :completed_on %>
      <%= f.date_field :completed_on, class: 'input' %>
    </div>

    <div>
      <%= f.label :sort_order %>
      <%= f.number_field :sort_order, class: 'input', min: 0 %>
    </div>

    <div>
      <%= f.label :site_url %>
      <%= f.url_field :site_url, class: 'input' %>
    </div>

    <div>
      <%= f.label :repo_url %>
      <%= f.url_field :repo_url, class: 'input' %>
    </div>

    <div class="full">
      <%= f.label :image_url %>
      <%= f.url_field :image_url, class: 'input' %>
    </div>

    <div class="full">
      <%= f.label :summary %>
      <%= f.text_area :summary, class: 'input', rows: 4, required: true %>
    </div>

    <div class="full">
      <%= f.label :description %>
      <%= f.text_area :description, class: 'input', rows: 5 %>
    </div>
  </div>

  <div class="card mt">
    <h3>Skills</h3>
    <div class="skills-select" data-skills-select>
      <details>
        <summary data-skills-summary>Select skills</summary>
        <div class="skills-select-options">
          <%= f.collection_check_boxes :skill_ids, Skill.all, :id, :name do |cb| %>
            <label class="skills-select-option">
              <%= cb.check_box %> <%= cb.text %>
            </label>
          <% end %>
        </div>
      </details>
      <div class="skills-select-chips" data-skills-chips></div>
    </div>
  </div>

  <div class="card mt">
    <h3>Project metrics</h3>
    <div id="metric-rows">
      <%= f.fields_for :project_metrics do |mf| %>
        <%= render 'metric_fields', mf: mf %>
      <% end %>
    </div>

    <button type="button" class="secondary mt add-fields-btn" data-fields-container="metric-rows" data-fields-template="metric-template">+ Add another metric</button>

    <template id="metric-template">
      <%= f.fields_for :project_metrics, ProjectMetric.new, child_index: 'NEW_RECORD_INDEX' do |mf| %>
        <%= render 'metric_fields', mf: mf %>
      <% end %>
    </template>
  </div>

  <div class="form-actions">
    <%= f.submit(@project.persisted? ? 'Save project' : 'Create project', class: 'primary') %>
    <%= link_to 'Cancel', @project.persisted? ? admin_project_path(@project) : admin_projects_path, class: 'secondary' %>
  </div>
<% end %>
