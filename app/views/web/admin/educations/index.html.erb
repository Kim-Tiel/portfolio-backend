<div class="actions-row" style="justify-content: space-between; align-items: center;">
  <div>
    <h2>Education</h2>
    <p class="small">Manage education entries and milestones.</p>
  </div>
  <div>
    <%= link_to 'New education', admin_new_education_path, class: 'primary' %>
  </div>
</div>

<table style="width:100%;border-collapse:collapse;margin-top:16px">
  <thead>
    <tr style="text-align:left;border-bottom:1px solid #e6eefc">
      <th style="padding:10px">Institution</th>
      <th style="padding:10px">Degree</th>
      <th style="padding:10px">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @educations.each do |edu| %>
      <tr style="border-bottom:1px solid #f1f5fb">
        <td style="padding:10px;vertical-align:top"><%= edu.institution %></td>
        <td style="padding:10px;vertical-align:top"><%= edu.degree %></td>
        <td style="padding:10px;vertical-align:top">
          <%= link_to 'View', admin_education_path(edu), class: 'secondary' %>
          <%= link_to 'Edit', admin_edit_education_path(edu), class: 'secondary' %>
          <%= button_to 'Delete', admin_education_path(edu), method: :delete, data: { confirm: 'Remove this education?' }, class: 'danger', form: { style: 'display:inline' } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
