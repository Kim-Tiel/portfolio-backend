<%= form_with model: [:admin, @education], local: true do |f| %>
  <% if @education.errors.any? %>
    <div class="card" style="background:#fff6f6;border:1px solid #ffdede;margin-bottom:16px">
      <p style="color:#7f1d1d;font-weight:700">Please fix the following errors:</p>
      <ul>
        <% @education.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
    <div>
      <%= f.label :institution %>
      <%= f.text_field :institution, class: 'input', required: true %>
    </div>

    <div>
      <%= f.label :degree %>
      <%= f.text_field :degree, class: 'input', required: true %>
    </div>

    <div>
      <%= f.label :location %>
      <%= f.text_field :location, class: 'input' %>
    </div>

    <div>
      <%= f.label :sort_order %>
      <%= f.number_field :sort_order, class: 'input', min: 0 %>
    </div>
  </div>

  <% if @education.education_milestones.any? %>
    <div class="card" style="margin-top:18px">
      <h3>Milestones</h3>
      <% f.fields_for :education_milestones do |mf| %>
        <div style="display:grid;grid-template-columns:1fr auto;gap:12px;align-items:end;margin-top:12px">
          <div>
            <%= mf.label :description %>
            <%= mf.text_field :description, class: 'input' %>
          </div>
          <div>
            <%= mf.label :occurred_on %>
            <%= mf.date_field :occurred_on, class: 'input' %>
            <%= mf.check_box :_destroy %>
            <%= mf.label :_destroy, 'Remove' %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div style="margin-top:18px;display:flex;gap:10px;flex-wrap:wrap;align-items:center">
    <%= f.submit(@education.persisted? ? 'Save education' : 'Create education', class: 'primary') %>
    <%= link_to 'Cancel', @education.persisted? ? admin_education_path(@education) : admin_educations_path, class: 'secondary' %>
  </div>
<% end %>
