<%= form_with model: [:admin, @education], local: true, data: (@education.persisted? ? { confirm_message: 'Are you sure do you want to save data?', confirm_action: 'Save', confirm_skip_unchanged: 'true' } : {}) do |f| %>
  <% if @education.errors.any? %>
    <div class="card form-errors">
      <p>Please fix the following errors:</p>
      <ul>
        <% @education.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div>
      <%= f.label :institution %>
      <%= f.text_field :institution, class: 'input', required: true %>
    </div>

    <div>
      <%= f.label :degree %>
      <%= f.text_field :degree, class: 'input', required: true %>
    </div>

    <div>
      <%= f.label :field %>
      <%= f.text_field :field, class: 'input', required: true %>
    </div>

    <div>
      <%= f.label :location %>
      <%= f.text_field :location, class: 'input' %>
    </div>

    <div>
      <%= f.label :start_date %>
      <%= f.date_field :start_date, class: 'input', required: true %>
    </div>

    <div>
      <%= f.label :end_date %>
      <%= f.date_field :end_date, class: 'input' %>
    </div>

    <div>
      <%= f.label :is_graduated %>
      <div class="checkbox-field">
        <%= f.check_box :is_graduated %>
        <%= f.label :is_graduated, 'Graduated' %>
      </div>
    </div>

    <div>
      <%= f.label :sort_order %>
      <%= f.number_field :sort_order, class: 'input', min: 0 %>
    </div>
  </div>


  <div class="card mt">
    <h3>Milestones</h3>
    <div id="milestone-rows">
      <%= f.fields_for :education_milestones do |mf| %>
        <%= render 'milestone_fields', mf: mf %>
      <% end %>
    </div>


    <button type="button" class="secondary mt add-fields-btn" data-fields-container="milestone-rows" data-fields-template="milestone-template">+ Add another milestone</button>

    <template id="milestone-template">
      <%= f.fields_for :education_milestones, EducationMilestone.new, child_index: 'NEW_RECORD_INDEX' do |mf| %>
        <%= render 'milestone_fields', mf: mf %>
      <% end %>
    </template>
  </div>

  <div class="form-actions">
    <%= f.submit(@education.persisted? ? 'Save education' : 'Create education', class: 'primary') %>
    <%= link_to 'Cancel', @education.persisted? ? admin_education_path(@education) : admin_educations_path, class: 'secondary' %>
  </div>
<% end %>
