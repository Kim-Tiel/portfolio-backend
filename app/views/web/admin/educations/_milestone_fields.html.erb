<div class="highlight-row" data-fields-row>
  <div>
    <%= mf.label :description %>
    <%= mf.text_field :description, class: 'input' %>
  </div>
  <div>
    <%= mf.label :occurred_on %>
    <%= mf.date_field :occurred_on, class: 'input' %>
  </div>
  <div>
    <%= mf.check_box :_destroy, style: 'display: none' %>
    <button type="button" class="secondary remove-fields-btn">Remove</button>
  </div>
</div>
