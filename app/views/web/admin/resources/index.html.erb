<h2><%= @model_name.pluralize %></h2>
<p class="small">Showing recent records for <strong><%= @model_name %></strong>. Click an item to view details.</p>

<% if @records.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Summary</th>
        <th>Created</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @records.each do |r| %>
        <tr>
          <td class="meta"><%= r.id %></td>
          <td><%= (r.respond_to?(:title) && r.title.present?) ? r.title : (r.respond_to?(:name) && r.name.present?) ? r.name : r.to_s %></td>
          <td class="meta"><%= r.try(:created_at)&.strftime('%Y-%m-%d %H:%M') %></td>
          <td class="actions"><%= link_to 'View', admin_resource_item_path(params[:resource], r), class: 'secondary' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <p>No <%= @model_name.pluralize.downcase %> yet.</p>
  </div>
<% end %>

<p class="mt"><%= link_to 'Back to dashboard', dashboard_path %></p>
