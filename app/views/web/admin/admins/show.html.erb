<h2><%= @admin.email %></h2>
<p class="small">Admin account details.</p>

<div class="card mt">
  <p><strong>Email:</strong> <%= @admin.email %></p>
  <p><strong>Last login:</strong> <%= @admin.last_login_at&.strftime('%Y-%m-%d %H:%M') || 'Never' %></p>
  <p><strong>Created:</strong> <%= @admin.created_at.strftime('%Y-%m-%d %H:%M') %></p>
</div>

<p class="mt"><%= link_to 'Back', admin_admins_path, class: 'secondary' %></p>
