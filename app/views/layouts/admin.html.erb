<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <title><%= content_for?(:title) ? "#{yield(:title)} · Portfolio CMS" : "Portfolio CMS" %></title>
  <%= stylesheet_link_tag 'admin', media: 'all' %>
</head>
<body>
  <%= render 'shared/admin_header' %>
  <%= render 'shared/admin_sidebar' %>

  <div class="container main-content">
    <% if flash.present? %>
      <div class="card flash-card">
        <% flash.each do |k, v| %>
          <div class="<%= k == 'alert' ? 'flash-alert' : 'flash-notice' %>"><strong><%= v %></strong></div>
        <% end %>
      </div>
    <% end %>

    <%= yield %>

    <%= render 'shared/confirm_modal' %>
  </div>

  <%= javascript_include_tag 'admin' %>
</body>
</html>
