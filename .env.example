# Copy to .env and fill in real values. .env is gitignored.

# Database (development)
DATABASE_HOST=localhost
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Auth
JWT_SECRET=

# CORS
FRONTEND_ORIGINS=http://localhost:3000

# Public hostname of this API — used to build Active Storage image URLs (production)
APP_HOST=api.example.com

# AWS S3 (Active Storage :amazon service)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=portfolio-backend-uploads-8x2k9f
